{
  "model": {
    "training_stage": "concat_lcf_qat",
    "communication_training_mode": "qat",
    "receiver_model": "${CACHECODEC_MODEL_ROOT}/Qwen3-0.6B",
    "sharer_model": "${CACHECODEC_MODEL_ROOT}/Qwen2.5-0.5B-Instruct",
    "cache_alignment": "concat",
    "fusion_type": "original",
    "concat_projector": {
      "type": "jcb",
      "shared_latent_dim": 128,
      "key_latent_dim": 64,
      "value_latent_dim": 64,
      "layer_mapping": "last_aligned",
      "rope_mode": "pre_rope"
    },
    "dct_qat": {
      "enabled": true,
      "beta": 1.0,
      "low": 1.0,
      "high": 8.0,
      "straight_through": true
    },
    "adaptive_quant_table": {"enabled": false}
  },
  "training": {
    "learning_rate": 0.0001,
    "weight_decay": 0.01,
    "num_epochs": 1,
    "max_length": 2048,
    "device": "cuda",
    "scheduler_type": "linear",
    "warmup_ratio": 0.1,
    "max_grad_norm": 1.0,
    "gradient_accumulation_steps": 16,
    "per_device_train_batch_size": 1,
    "freeze": ["teacher", "base"],
    "seed": 42,
    "early_stopping": {
      "enabled": true,
      "window_size": 20,
      "patience": 3,
      "min_delta": 0.001
    }
  },
  "output": {
    "output_dir": "${CACHECODEC_RUN_ROOT}/checkpoints/concat_lcf_qat_qwen25_05_to_qwen3_06",
    "save_steps": 100,
    "eval_steps": 100,
    "keep_only_latest_checkpoint": true
  },
  "data": {
    "type": "OpenHermesChatDataset",
    "kwargs": {
      "split": "train",
      "dataset_name": "teknium/OpenHermes-2.5",
      "local_arrow_file": "${CACHECODEC_DATA_ROOT}/open_hermes-2.5-train.arrow",
      "num_samples": 500000,
      "max_word_count": 2048,
      "min_conversation_turns": 0
    },
    "train_ratio": 0.99
  }
}
